# Copy this file to .env (same folder as docker-compose.yml) and adjust as
# needed. `docker compose up` reads .env automatically - nothing else to wire
# up. Every value below has a working default already, so an empty/missing
# .env is fine too; this file only matters once you want to change something.

# --- Ports on YOUR machine (the container-internal ports never change) ---
GIGLISTER_DB_PORT=5432
GIGLISTER_BACKEND_PORT=8080
GIGLISTER_FRONTEND_PORT=3000

# --- URLs built from the ports above - keep these in sync manually ---
# GIGLISTER_PUBLIC_API_URL: baked into the frontend's browser bundle at BUILD
# time (`docker compose build`/`up --build`), because the browser calls the
# API directly, not through Docker's internal network. If you change
# GIGLISTER_BACKEND_PORT, update this to match and rebuild the frontend image.
GIGLISTER_PUBLIC_API_URL=http://localhost:8080
# GIGLISTER_FRONTEND_URL: used by the backend to build the links inside
# verification/password-reset emails. Keep this in sync with
# GIGLISTER_FRONTEND_PORT above.
GIGLISTER_FRONTEND_URL=http://localhost:3000

# --- Backend ---
# Change this for anything beyond local dev - it signs every login token.
GIGLISTER_JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# The very first account ever registered becomes PLATFORM_ADMIN
# automatically, so this is optional. Set it only if you want to control
# in advance exactly which email that should be (it always wins over the
# first-user fallback, regardless of registration order).
GIGLISTER_ADMIN_EMAIL=

# --- Mail (optional) ---
# Leave GIGLISTER_MAIL_HOST empty (the default) to skip real email entirely -
# verification/reset links are written to `docker compose logs backend`
# instead. Fill all five in to send through a real SMTP server.
GIGLISTER_MAIL_HOST=
GIGLISTER_MAIL_PORT=587
GIGLISTER_MAIL_USER=
GIGLISTER_MAIL_PASSWORD=
GIGLISTER_MAIL_FROM=no-reply@giglister.local
