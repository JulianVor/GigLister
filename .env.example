# Copy this file to .env (same folder as docker-compose.yml) and adjust as
# needed. `docker compose up` reads .env automatically - nothing else to wire
# up. Every value below has a working default already, so an empty/missing
# .env is fine too; this file only matters once you want to change something.

# --- Ports on YOUR machine (the container-internal ports never change) ---
GIGLISTER_DB_PORT=5432
GIGLISTER_BACKEND_PORT=8080
GIGLISTER_FRONTEND_PORT=3000
# Mailpit's web UI - every verification/reset email the backend sends shows
# up here by default, see the Mail section below.
GIGLISTER_MAILPIT_PORT=8025

# --- URLs built from the ports above - keep these in sync manually ---
# GIGLISTER_PUBLIC_API_URL: baked into the frontend's browser bundle at BUILD
# time (`docker compose build`/`up --build`), because the browser calls the
# API directly, not through Docker's internal network. Also passed to the
# backend at runtime, which uses it to build the URL of an uploaded image
# (logo/title image) - so both need it, and both need it to match. If you
# change GIGLISTER_BACKEND_PORT, update this to match and rebuild.
GIGLISTER_PUBLIC_API_URL=http://localhost:8080
# GIGLISTER_FRONTEND_URL: used by the backend to build the links inside
# verification/password-reset emails. Keep this in sync with
# GIGLISTER_FRONTEND_PORT above.
GIGLISTER_FRONTEND_URL=http://localhost:3000

# --- Backend ---
# Change this for anything beyond local dev - it signs every login token.
GIGLISTER_JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
# Maximum size (in MB) for an uploaded Band/Location/Event image - one value
# drives all of it: the backend's own limit (UploadService, and the GPT-skill
# image-URL fetch in ImageFetchService) and, on the frontend, both the
# client-side check in ImageUploadField and the Server Action body limit.
# Only takes effect on `docker compose up --build` - the frontend bakes it
# in at image build time, same as GIGLISTER_PUBLIC_API_URL below.
GIGLISTER_UPLOAD_MAX_SIZE_MB=5
# The very first account ever registered becomes PLATFORM_ADMIN
# automatically, so this is optional. Set it only if you want to control
# in advance exactly which email that should be (it always wins over the
# first-user fallback, regardless of registration order).
GIGLISTER_ADMIN_EMAIL=

# --- GPT-skill integration (optional) ---
# Shared secret for an external GPT-skill/ChatGPT Action that submits Band/
# Location/Event proposals to POST /api/submissions for admin review (see
# /admin/submissions) - it can never create anything directly. Leave empty
# to disable the integration entirely (nobody can authenticate as it).
GIGLISTER_GPT_SKILL_TOKEN=

# --- Mail (optional) ---
# By default every verification/reset email goes to the mailpit container
# (see docker-compose.yml) instead of a real inbox - open
# http://localhost:8025 (GIGLISTER_MAILPIT_PORT above) to read them. Fill in
# all five below to send through a real SMTP server instead; leaving
# GIGLISTER_MAIL_HOST set to "mailpit" (or blank) keeps using the local
# catch-all.
GIGLISTER_MAIL_HOST=mailpit
GIGLISTER_MAIL_PORT=587
GIGLISTER_MAIL_USER=
GIGLISTER_MAIL_PASSWORD=
GIGLISTER_MAIL_FROM=no-reply@giglister.local
